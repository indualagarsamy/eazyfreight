{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ItnRecordResponse.schema.json",
  "title": "ItnRecordResponse",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "itnNumber": {
      "type": "string"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "active": {
      "type": "boolean"
    },
    "simulated": {
      "type": "boolean"
    },
    "supersededByItnId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "recordedBy": {
      "type": "string"
    }
  }
}
