{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "HistoryEntry.schema.json",
  "title": "HistoryEntry",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "sequenceNumber": {
      "type": "integer"
    },
    "action": {
      "$ref": "AlertHistoryAction.schema.json"
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "string"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
