{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Distribute.schema.json",
  "title": "Distribute",
  "type": "object",
  "required": [
    "recipient"
  ],
  "properties": {
    "recipient": {
      "$ref": "DistributionRecipient.schema.json"
    },
    "recipientName": {
      "type": "string"
    },
    "recipientAddress": {
      "type": "string"
    },
    "channel": {
      "$ref": "DistributionChannel.schema.json"
    },
    "reference": {
      "type": "string"
    }
  }
}
