{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TerminalGateReceipt.schema.json",
  "title": "TerminalGateReceipt",
  "type": "object",
  "required": [
    "gateReceiptNumber",
    "terminalName"
  ],
  "properties": {
    "gateReceiptNumber": {
      "type": "string",
      "minLength": 1
    },
    "terminalName": {
      "type": "string",
      "minLength": 1
    },
    "earliestAcceptanceDate": {
      "type": "string",
      "format": "date"
    },
    "vesselCutOffDate": {
      "type": "string",
      "format": "date"
    },
    "storageFeeDailyRate": {
      "type": "number"
    }
  }
}
