{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "BookingCargoDetailRequest.schema.json",
  "title": "BookingCargoDetailRequest",
  "type": "object",
  "required": [
    "description",
    "hsCode",
    "pieces",
    "weightKg",
    "lengthCm",
    "widthCm",
    "heightCm",
    "valueUsd"
  ],
  "properties": {
    "description": {
      "type": "string",
      "minLength": 1
    },
    "hsCode": {
      "type": "string",
      "pattern": "\\d{4}\\.\\d{2}\\.\\d{4}"
    },
    "pieces": {
      "type": "integer",
      "minimum": 1
    },
    "weightKg": {
      "type": "number",
      "minimum": 0.001
    },
    "lengthCm": {
      "type": "number",
      "minimum": 0.01
    },
    "widthCm": {
      "type": "number",
      "minimum": 0.01
    },
    "heightCm": {
      "type": "number",
      "minimum": 0.01
    },
    "valueUsd": {
      "type": "number",
      "minimum": 0.0
    },
    "hazmat": {
      "type": "boolean"
    },
    "temperatureControlled": {
      "type": "boolean"
    },
    "oversized": {
      "type": "boolean"
    },
    "marksAndNumbers": {
      "type": "string"
    }
  }
}
