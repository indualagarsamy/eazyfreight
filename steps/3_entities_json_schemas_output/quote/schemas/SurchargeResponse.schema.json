{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SurchargeResponse.schema.json",
  "title": "SurchargeResponse",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "surchargeType": {
      "$ref": "SurchargeType.schema.json"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    },
    "validFrom": {
      "type": "string",
      "format": "date"
    },
    "validUntil": {
      "type": "string",
      "format": "date"
    },
    "expired": {
      "type": "boolean"
    }
  }
}
