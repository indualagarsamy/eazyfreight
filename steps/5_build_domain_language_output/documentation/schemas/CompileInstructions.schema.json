{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CompileInstructions.schema.json",
  "title": "CompileInstructions",
  "type": "object",
  "description": "Overrides for the instruction snapshot. Everything else is pulled from the booking, logistics and compliance records at compile time. No field is required \u2014 all are optional overrides.",
  "properties": {
    "shipperName": {
      "type": "string"
    },
    "shipperAddress": {
      "type": "string"
    },
    "consigneeName": {
      "type": "string"
    },
    "consigneeAddress": {
      "type": "string"
    },
    "notifyPartyName": {
      "type": "string"
    },
    "notifyPartyAddress": {
      "type": "string"
    },
    "marksAndNumbers": {
      "type": "string"
    },
    "freightTerms": {
      "$ref": "FreightTerms.schema.json"
    },
    "documentationCutOffDate": {
      "type": "string",
      "format": "date"
    }
  }
}
