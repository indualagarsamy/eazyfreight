{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "DispatchTruck.schema.json",
  "title": "DispatchTruck",
  "type": "object",
  "required": [
    "pickupAddress",
    "deliveryAddress"
  ],
  "properties": {
    "driverId": {
      "type": "string",
      "format": "uuid"
    },
    "truckingVendorId": {
      "type": "string",
      "format": "uuid"
    },
    "vehicleReference": {
      "type": "string"
    },
    "pickupAddress": {
      "type": "string",
      "minLength": 1
    },
    "deliveryAddress": {
      "type": "string",
      "minLength": 1
    },
    "scheduledPickupDate": {
      "type": "string",
      "format": "date-time"
    },
    "scheduledDeliveryDate": {
      "type": "string",
      "format": "date-time"
    }
  }
}
