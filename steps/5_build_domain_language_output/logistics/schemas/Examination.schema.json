{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Examination.schema.json",
  "title": "Examination",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "holdPlacedAt": {
      "type": "string",
      "format": "date-time"
    },
    "examinationCompletedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "result": {
      "$ref": "ExaminationResult.schema.json"
    },
    "originalSealId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "replacementSealId": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "cbpOfficerId": {
      "type": [
        "string",
        "null"
      ]
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "open": {
      "type": "boolean"
    }
  }
}
