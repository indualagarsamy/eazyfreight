{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PaymentView.schema.json",
  "title": "PaymentView",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "amount": {
      "$ref": "common/MonetaryAmount.schema.json"
    },
    "currency": {
      "$ref": "common/Currency.schema.json"
    },
    "paymentDate": {
      "type": "string",
      "format": "date"
    },
    "paymentMethod": {
      "$ref": "PaymentMethod.schema.json"
    },
    "reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "recordedBy": {
      "type": "string"
    }
  }
}
