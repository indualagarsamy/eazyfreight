{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "BuildQuotationRequest.schema.json",
  "title": "BuildQuotationRequest",
  "type": "object",
  "required": [
    "lines",
    "validityDays"
  ],
  "properties": {
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "QuoteLineRequest.schema.json"
      }
    },
    "validityDays": {
      "type": "integer",
      "minimum": 1
    },
    "rateValidUntil": {
      "type": "string",
      "format": "date",
      "description": "Earliest expiry among the carrier rates these lines were priced from; acceptance is refused once it passes."
    },
    "spotRate": {
      "type": "boolean"
    },
    "notes": {
      "type": "string"
    }
  }
}
