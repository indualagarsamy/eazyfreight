{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common/CargoDimensionsInput.schema.json",
  "title": "CargoDimensionsInput",
  "description": "Physical cargo dimensions as submitted on a request, shared by every schema in this context that accepts cargo detail input. Duplicated identically in booking/schemas/common — quote and booking are separate bounded contexts and neither $refs the other's schemas (see steps/4_consolidate_entities.md), so each context keeps its own copy.",
  "type": "object",
  "required": [
    "description",
    "hsCode",
    "pieces",
    "weightKg",
    "lengthCm",
    "widthCm",
    "heightCm"
  ],
  "properties": {
    "description": {
      "type": "string",
      "minLength": 1
    },
    "hsCode": {
      "type": "string",
      "pattern": "\\d{4}\\.\\d{2}\\.\\d{4}"
    },
    "pieces": {
      "type": "integer",
      "minimum": 1
    },
    "weightKg": {
      "type": "number",
      "minimum": 0.001
    },
    "lengthCm": {
      "type": "number",
      "minimum": 0.01
    },
    "widthCm": {
      "type": "number",
      "minimum": 0.01
    },
    "heightCm": {
      "type": "number",
      "minimum": 0.01
    },
    "hazmat": {
      "type": "boolean"
    },
    "temperatureControlled": {
      "type": "boolean"
    },
    "oversized": {
      "type": "boolean"
    }
  }
}
